# ==============================================================================
# Безопасность и конфиденциальные данные (Secrets & Credentials)
# ==============================================================================
# Блокировка всех файлов с переменными окружения
.env
.env.*
!.env.example
!.env.template

# Ключи, сертификаты и учетные записи
*.pem
*.key
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*
credentials.json
token.json
secrets/
*secret*

# Дампы и файлы баз данных
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
data/
pgdata/

# ==============================================================================
# Python / Backend (FastAPI, Alembic, pytest)
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Виртуальные окружения
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Тестирование и покрытие
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ==============================================================================
# Frontend (Next.js, Node.js)
# ==============================================================================
node_modules/
.next/
out/
build/
dist/

# Логи пакетов
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js telemetry
.next/cache/

# ==============================================================================
# Логи и инфраструктура (Docker, Nginx, Redis, RabbitMQ)
# ==============================================================================
*.log
logs/
*.pid
docker-compose.override.yml

# ==============================================================================
# Системные файлы и IDE
# ==============================================================================
.DS_Store
Thumbs.db
Desktop.ini

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

